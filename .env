# ==============================================================================
# College Management System - Environment Configuration
# ==============================================================================

# Flask Configuration
FLASK_ENV=development
FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-very-secure-random-secret-key-32-chars

# Server Configuration
PORT=5000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS & DynamoDB Configuration
AWS_REGION=us-east-1
# Set DYNAMODB_ENDPOINT_URL for local development with DynamoDB Local
# For AWS deployment (IAM Instance Profile), leave this empty or unset
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# DynamoDB Table Names
DYNAMODB_TABLE_USERS=cms_users
DYNAMODB_TABLE_STUDENTS=cms_students
DYNAMODB_TABLE_ATTENDANCE=cms_attendance
DYNAMODB_TABLE_RESULTS=cms_results
DYNAMODB_TABLE_EXAMS=cms_exams
DYNAMODB_TABLE_QUESTIONS=cms_questions
DYNAMODB_TABLE_SUBMISSIONS=cms_submissions
DYNAMODB_TABLE_AUDIT_LOGS=cms_audit_logs

# S3 Configuration
# For local dev using MinIO / LocalStack (optional), or leave blank for AWS S3
S3_ENDPOINT_URL=
S3_BUCKET_NAME=college-mgmt-system-bucket-dev
S3_PRESIGNED_EXPIRATION_SECONDS=3600

# Security & Rate Limiting
LOGIN_RATE_LIMIT_PER_MINUTE=5
BCRYPT_LOG_ROUNDS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
